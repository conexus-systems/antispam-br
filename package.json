{
  "name": "antispam-br",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.26",
    "expo-application": "^57.0.3",
    "expo-constants": "~57.0.20",
    "expo-crypto": "^57.0.3",
    "expo-haptics": "^57.0.3",
    "expo-linear-gradient": "^57.0.2",
    "expo-linking": "^57.0.11",
    "expo-notifications": "^57.0.21",
    "expo-router": "^57.0.24",
    "expo-status-bar": "~57.0.1",
    "qrcode-generator": "1.4.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-qrcode-svg": "6.3.15",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@types/jest": "~29.5.14",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.1",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|qrcode-generator)"
    ]
  }
}
