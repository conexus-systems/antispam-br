{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://antispam.br/schemas/dataset-manifest.schema.json",
  "title": "Manifest de dataset versionado e assinado",
  "type": "object",
  "required": ["version", "timestamp", "files", "record_count", "signature"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "previous_version": { "type": ["string", "null"] },
    "record_count": { "type": "integer", "minimum": 0 },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes", "records"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "pattern": "^[a-z0-9/._-]+\\.bin\\.zst$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "records": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "license": { "type": "string", "description": "ex.: CC0-1.0 ou ODbL-1.0" },
    "signature": {
      "type": "object",
      "required": ["alg", "public_key_id", "value"],
      "additionalProperties": false,
      "properties": {
        "alg": { "type": "string", "const": "Ed25519" },
        "public_key_id": { "type": "string" },
        "value": { "type": "string", "pattern": "^[a-f0-9]{128}$" }
      }
    }
  }
}
