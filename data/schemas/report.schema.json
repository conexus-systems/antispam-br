{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://antispam.br/schemas/report.schema.json",
  "title": "Denúncia comunitária (opt-in)",
  "type": "object",
  "required": ["number_hash", "category", "timestamp", "country", "confidence", "source"],
  "additionalProperties": false,
  "properties": {
    "number_hash": {
      "type": "string",
      "description": "SHA-256 do número normalizado E.164 (sem +). Nunca enviar o número cru ao backend.",
      "pattern": "^[a-f0-9]{64}$"
    },
    "category": {
      "type": "string",
      "enum": [
        "TELEMARKETING", "ROBOCALL", "SILENT_CALL", "COLLECTION", "BANK_SCAM",
        "PIX_SCAM", "PHISHING", "DELIVERY_SCAM", "FAKE_SUPPORT", "LOAN",
        "SURVEY", "SPOOFING", "LEGITIMATE", "OTHER"
      ]
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "source": {
      "type": "string",
      "enum": ["USER_REPORT", "USER_CONFIRMATION", "USER_CONTEST", "LOCAL_PATTERN", "PARTNER_FEED"]
    },
    "optional_comment": {
      "type": "string",
      "maxLength": 280,
      "description": "Opcional. Nunca publicado sem moderação; sem dados pessoais."
    }
  }
}
